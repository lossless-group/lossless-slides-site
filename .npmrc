ignore-workspace=true
# Treat this project as standalone — do not try to discover or use the
# parent astro-knots workspace. Critical for Vercel: without this, pnpm
# would error out looking for pnpm-workspace.yaml.

# Hoist dependencies into a flat node_modules so packages that expect a
# classic node_modules layout (some Vite/Rollup/Astro plugins) work.
shamefully-hoist=true

# Auto-install peer dependencies so we don't have to enumerate them.
auto-install-peers=true

# Don't fail builds on peer-dependency mismatches.
strict-peer-dependencies=false

# JSR registry — required to resolve @jsr/* aliased deps such as
# @lossless-group/lfm, once this site renders markdown. Public, no auth token.
@jsr:registry=https://npm.jsr.io
