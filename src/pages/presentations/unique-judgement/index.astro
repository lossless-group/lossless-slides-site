---
/**
 * Deck v1 · "Scorecard" voice. Generated in one pass from
 * src/content/presentations/unique-judgement/outline.md.
 * Slides live in src/layouts/sections/unique-judgement/v1/.
 * A new version gets its own folder and page, never an edit of this one.
 */
import DeckLayout from '@layouts/DeckLayout.astro';
import PageDeck from '@layouts/PageDeck.astro';
import DeckChrome from '@components/deck/DeckChrome.astro';
import { getDeckContext } from '@lib/decks';

import OSlide from '@layouts/sections/unique-judgement/v1/OSlide.astro';
import S01Cover from '@layouts/sections/unique-judgement/v1/S01-Cover.astro';
import S02Consensus from '@layouts/sections/unique-judgement/v1/S02-Consensus.astro';
import S03Approach from '@layouts/sections/unique-judgement/v1/S03-Approach.astro';
import S04FiveQuestions from '@layouts/sections/unique-judgement/v1/S04-Five-Questions.astro';
import S08Offering from '@layouts/sections/unique-judgement/v1/S08-Offering.astro';
import S10MissionCatalysts from '@layouts/sections/unique-judgement/v1/S10-Mission-Catalysts.astro';
import S11AtScale from '@layouts/sections/unique-judgement/v1/S11-At-Scale.astro';
import S12EvaluatingGPs from '@layouts/sections/unique-judgement/v1/S12-Evaluating-GPs.astro';
import S13ScoringScale from '@layouts/sections/unique-judgement/v1/S13-Scoring-Scale.astro';
import S14Different from '@layouts/sections/unique-judgement/v1/S14-Different.astro';
import S15Result from '@layouts/sections/unique-judgement/v1/S15-Result.astro';
import S16Takeaways from '@layouts/sections/unique-judgement/v1/S16-Takeaways.astro';
import S17Close from '@layouts/sections/unique-judgement/v1/S17-Close.astro';

export const prerender = true;

const context = getDeckContext(Astro.url.pathname);
if (!context) throw new Error(`No deck registered for ${Astro.url.pathname}`);
const { deck } = context;
---

<DeckLayout title={`${deck.title} · ${deck.subtitle}`} description={deck.summary} noindex>
  <PageDeck label={deck.title}>
    <S01Cover />
    <S02Consensus />
    <S03Approach />
    <S04FiveQuestions />
    <OSlide
      id="s05-origins"
      number={5}
      position={1}
      name="Origins"
      question="Why Would Anyone Care?"
      kicker="The Customer Foundation"
      ps={[
        { name: 'Persona', body: 'Who is the target customer?' },
        { name: 'Pain', body: 'What problem do they have?' },
        { name: 'Proposition', body: 'What transformation are you promising?' },
      ]}
      note="Hair-on-fire problems beat nice-to-haves every time"
    />
    <OSlide
      id="s06-opening"
      number={6}
      position={2}
      name="Opening"
      question="How Big Is This Opportunity?"
      kicker="Market Reality Check"
      ps={[
        { name: 'Problem', body: 'How many customers exist?' },
        { name: 'Possibility', body: 'TAM, SAM, SOM analysis' },
        { name: 'Positioning', body: 'Blue Ocean vs. Red Ocean' },
      ]}
      note="We look for macro trends amplifying the problem and pointing to this unique opportunity."
    />
    <OSlide
      id="s07-organization"
      number={7}
      position={3}
      name="Organization"
      question="Who Is Building This?"
      kicker="Team Assessment"
      ps={[
        { name: 'People', body: 'Founder-market fit' },
        { name: 'Process', body: 'Growth engine and best practices' },
        { name: 'Product', body: 'Does it deliver on the promise?' },
      ]}
      note="The right team with the wrong idea can pivot. The wrong team cannot."
    />
    <S08Offering />
    <OSlide
      id="s09-opportunity"
      number={9}
      position={5}
      name="Opportunity"
      question="Is This Worth Our Capital?"
      kicker="Investment Worthiness"
      ps={[
        { name: 'Potential', body: 'Projected growth trajectory' },
        { name: 'Progress', body: 'Indisputable, undeniable traction' },
        { name: 'Plan', body: 'Use of proceeds and milestones' },
      ]}
      note="Hard numbers over hopeful narratives"
    />
    <S10MissionCatalysts />
    <S11AtScale />
    <S12EvaluatingGPs />
    <S13ScoringScale />
    <S14Different />
    <S15Result />
    <S16Takeaways />
    <S17Close />
  </PageDeck>
  <DeckChrome context={context} />
</DeckLayout>
