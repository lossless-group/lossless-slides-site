---
/**
 * Design system: every component and style primitive this site ships, with
 * live samples. New or changed components land here in the same change.
 * Internal reference page, not indexed.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ModeToggle from '@components/basics/ModeToggle.astro';
import SlideFolio from '@components/deck/SlideFolio.astro';
import { DECKS } from '@lib/decks';

export const prerender = true;

const firstDeck = DECKS[0]?.versions[0]?.href;

const playerKeys = [
  ['↓ · PageDown · Space', 'Next slide (a slide taller than the screen scrolls first)'],
  ['↑ · PageUp · Shift+Space', 'Previous slide'],
  ['Home · End', 'First · last slide'],
  ['← · →', 'Previous · next version of the deck (DeckChrome)'],
  ['c', 'Hide or show the chrome'],
  ['f', 'Fullscreen'],
  ['m', 'Cycle color mode'],
  ['Esc', 'Show the chrome again'],
  ['Double-click', 'Upper half goes back, lower half goes forward'],
];

const pageDeckUsage = `<DeckLayout title="…" noindex>
  <PageDeck label="Deck title">
    <S01Cover />
    <S02Next />
  </PageDeck>
  <DeckChrome context={getDeckContext(Astro.url.pathname)} />
</DeckLayout>`;

const slideUsage = `<section class="deck-slide" id="s02-next" data-slot="next">
  <SlideFolio number={2} label="Next" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">Eyebrow</p>
    <h2 class="deck-title reveal-item" style="--delay: 90ms">Title</h2>
  </div>
</section>`;

const vocabulary = [
  ['.deck-slide', 'One slide: full-height, snaps, padded by --deck-pad-*'],
  ['.deck-inner', 'Centers content at --deck-measure'],
  ['.deck-eyebrow', 'Mono kicker; oxblood in light, aqua in vibrant'],
  ['.deck-title-xl / .deck-title', 'Display type at --deck-font-title(-xl)'],
  ['.deck-lede', 'Large supporting line; italic in light'],
  ['.deck-body / .deck-small', 'Running text sizes'],
  ['.deck-stat', 'Big tabular figure'],
  ['.deck-label', 'Small mono label'],
  ['.deck-rule', 'Ink rule in light, gradient glow in vibrant'],
  ['.deck-card', 'Card padding and radius (pair with .fx-surface)'],
  ['.deck-panel', 'Top rule in light and dark, glass card in vibrant'],
  ['.reveal-item', 'Fades in on arrival; stagger with style="--delay: 120ms"'],
];

const variants = [
  ['light:', 'Applies only in light mode'],
  ['dark:', 'Applies in dark and vibrant (vibrant is dark-based)'],
  ['vibrant:', 'Applies only in vibrant mode'],
];
---

<BaseLayout title="Design System · Lossless Slides" description="Components and style primitives for Lossless presentations." noindex>
  <div class="mx-auto max-w-6xl px-6 pt-12 pb-20">
    <header class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Internal reference</p>
      <h1 class="mt-2">Design system</h1>
      <p class="mt-4 text-muted-foreground">
        Components and primitives for PageDecks, shown live in the current mode. The pattern behind them: <code class="font-mono text-sm">context-v/blueprints/PageDeck-Pattern-for-Slide-Focused-Astro-Knots-Sites.md</code>.
        {firstDeck && (<> See them working in <a href={firstDeck} class="underline underline-offset-4">the first deck</a>.</>)}
      </p>
    </header>

    <section class="mt-14 border-t border-border pt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl">ModeToggle</h2>
        <code class="font-mono text-xs text-muted-foreground">src/components/basics/ModeToggle.astro</code>
      </div>
      <p class="mt-2 max-w-3xl text-muted-foreground">Cycles light → dark → vibrant and remembers the choice. Sits wherever it is placed; every toggle on a page shares one mode.</p>
      <div class="mt-5 flex items-center gap-4 rounded-lg border border-border p-6">
        <ModeToggle />
        <span class="text-sm text-muted-foreground">Click to cycle. Props: <code class="font-mono">class</code>.</span>
      </div>
    </section>

    <section class="mt-14 border-t border-border pt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl">PageDeck</h2>
        <code class="font-mono text-xs text-muted-foreground">src/layouts/PageDeck.astro</code>
      </div>
      <p class="mt-2 max-w-3xl text-muted-foreground">
        The player. Wraps slide components (each renders one top-level <code class="font-mono">&lt;section&gt;</code>) in a scroll-snap container with keyboard control, a slide counter, <code class="font-mono">#s-N</code> deep links, and reveal on arrival.
        Props: <code class="font-mono">label</code> (required), <code class="font-mono">enableScrollSnap</code>, <code class="font-mono">showHints</code>, <code class="font-mono">hintDuration</code>.
      </p>
      <pre class="mt-5 overflow-x-auto rounded-lg border border-border bg-card p-5 font-mono text-sm"><code>{pageDeckUsage}</code></pre>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-border text-muted-foreground">
              <th class="py-2 pr-6 font-medium">Key</th>
              <th class="py-2 font-medium">Action</th>
            </tr>
          </thead>
          <tbody>
            {playerKeys.map(([key, action]) => (
              <tr class="border-b border-border">
                <td class="py-2 pr-6 font-mono whitespace-nowrap text-foreground">{key}</td>
                <td class="py-2 text-muted-foreground">{action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">Keys with Cmd, Ctrl, or Alt held are left to the browser, so copying and finding still work.</p>
    </section>

    <section class="mt-14 border-t border-border pt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl">DeckChrome</h2>
        <code class="font-mono text-xs text-muted-foreground">src/components/deck/DeckChrome.astro</code>
      </div>
      <p class="mt-2 max-w-3xl text-muted-foreground">
        The floating capsule at the bottom right of a deck: back to the gallery, version cycling when a deck has more than one version, slide up and down, and the mode toggle. Talks to PageDeck only through <code class="font-mono">deck:section-*</code> events. Props: <code class="font-mono">context</code> (from <code class="font-mono">getDeckContext</code>), <code class="font-mono">homeHref</code>.
      </p>
    </section>

    <section class="mt-14 border-t border-border pt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl">SlideFolio</h2>
        <code class="font-mono text-xs text-muted-foreground">src/components/deck/SlideFolio.astro</code>
      </div>
      <p class="mt-2 max-w-3xl text-muted-foreground">The running head across the top of a slide. A double rule in light mode. Props: <code class="font-mono">number</code>, <code class="font-mono">label</code>.</p>
      <div class="page-deck relative mt-5 h-24 overflow-hidden rounded-lg border border-border">
        <SlideFolio number={6} label="By the numbers" />
      </div>
    </section>

    <section class="mt-14 border-t border-border pt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl">Deck vocabulary</h2>
        <code class="font-mono text-xs text-muted-foreground">src/styles/deck.css</code>
      </div>
      <p class="mt-2 max-w-3xl text-muted-foreground">
        Classes slides compose. Their sizes come from <code class="font-mono">--deck-*</code> tokens on <code class="font-mono">.page-deck</code>, the one place to tune a deck's scale. Improvise the rest in inline Tailwind.
      </p>
      <div class="page-deck mt-5 rounded-lg border border-border p-8">
        <p class="deck-eyebrow">Eyebrow · .deck-eyebrow</p>
        <p class="deck-title mt-3">A deck title in the current mode</p>
        <p class="deck-lede mt-3">A lede supports the title without competing with it.</p>
        <hr class="deck-rule mt-6 w-24" />
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="deck-panel">
            <p class="deck-stat gradient-text w-fit">51%</p>
            <p class="deck-small mt-3 text-muted-foreground">.deck-panel with .deck-stat</p>
          </div>
          <div class="deck-card fx-surface">
            <p class="deck-label">.deck-card + .fx-surface</p>
            <p class="deck-body mt-2">Body text at --deck-font-body.</p>
          </div>
          <div class="deck-panel">
            <p class="deck-label">.deck-label</p>
            <p class="deck-small mt-2 text-muted-foreground">Small text at --deck-font-small.</p>
          </div>
        </div>
      </div>
      <pre class="mt-5 overflow-x-auto rounded-lg border border-border bg-card p-5 font-mono text-sm"><code>{slideUsage}</code></pre>
      <dl class="mt-5 grid gap-x-8 gap-y-2 text-sm md:grid-cols-2">
        {vocabulary.map(([name, use]) => (
          <div class="flex gap-3 border-b border-border py-2">
            <dt class="w-48 shrink-0 font-mono text-foreground">{name}</dt>
            <dd class="text-muted-foreground">{use}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-14 border-t border-border pt-8">
      <h2 class="text-2xl">Mode variants</h2>
      <p class="mt-2 max-w-3xl text-muted-foreground">
        Tailwind variants for improvising per mode inside a slide. They apply to utilities only, not to the component classes above; a component class that changes per mode says so in <code class="font-mono">deck.css</code>.
      </p>
      <dl class="mt-5 grid gap-x-8 gap-y-2 text-sm md:grid-cols-3">
        {variants.map(([name, use]) => (
          <div class="border-b border-border py-2">
            <dt class="font-mono text-foreground">{name}</dt>
            <dd class="text-muted-foreground">{use}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 rounded-lg border border-border p-5 text-foreground light:border-foreground light:font-display light:italic vibrant:border-transparent vibrant:bg-muted">
        This box is ruled ink in light, plain in dark, and a violet wash in vibrant.
      </p>
    </section>
  </div>
</BaseLayout>
