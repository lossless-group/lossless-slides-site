---
import '@styles/globals.css';
import BaseHead from '@components/basics/BaseHead.astro';
import Header from '@components/basics/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Share image, absolute or site-relative. Omitted tags fall back to the site default. */
  image?: string;
  /** Internal reference pages (design system, brand kit) opt out of search indexing. */
  noindex?: boolean;
}

const SITE_MODE = import.meta.env.SITE_MODE ?? 'dark';

// No inline --primary / --secondary / --accent on <html>: an inline style
// outranks every [data-theme] block, which pinned all three modes to one
// palette. The mode tokens in tokens.css own those colors now.
---
<html lang="en" data-theme={SITE_MODE}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border px-6 py-8">
      <div class="max-w-6xl mx-auto text-center text-muted-foreground text-sm">
        &copy; {new Date().getFullYear()} The Lossless Group. All rights reserved.
      </div>
    </footer>
  </body>
</html>
