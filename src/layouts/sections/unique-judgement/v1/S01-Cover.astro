---
import SlideFolio from '@components/deck/SlideFolio.astro';
---

<section class="deck-slide" id="s01-cover" data-slot="cover">
  <SlideFolio number={1} label="Cover" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">The Lossless Group · In Evaluating Opportunities</p>
    <h1 class="deck-title-xl mt-6 max-w-[12ch] reveal-item" style="--delay: 90ms">
      Unique <span class="gradient-text">Judgement</span>
    </h1>
    <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 180ms" />
    <p class="deck-lede mt-8 reveal-item" style="--delay: 260ms">Why we see opportunities differently</p>
    <p class="deck-label mt-4 reveal-item" style="--delay: 320ms">Michael Staton · Made for Hypernova Capital</p>
  </div>
</section>
