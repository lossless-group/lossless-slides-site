---
import SlideFolio from '@components/deck/SlideFolio.astro';
---

<section class="deck-slide" id="s17-close" data-slot="close">
  <SlideFolio number={17} label="Close" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">Questions?</p>
    <h2 class="deck-title-xl mt-6 reveal-item" style="--delay: 90ms">Let's <span class="gradient-text">Discuss</span></h2>
    <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 180ms" />
    <p class="deck-lede mt-8 reveal-item" style="--delay: 260ms">
      Made for <a href="https://hypernova.capital" class="underline decoration-border underline-offset-4 hover:text-foreground">Hypernova Capital</a>: <em>Unique Judgement. Networked Capital.</em>
    </p>
    <div class="mt-5 flex flex-wrap gap-6 reveal-item" style="--delay: 340ms">
      <a href="/presentations/networked-capital" class="deck-label underline decoration-border underline-offset-4 hover:text-foreground">Also: Networked Capital</a>
      <a href="https://www.lossless.group" class="deck-label underline decoration-border underline-offset-4 hover:text-foreground">lossless.group</a>
    </div>
  </div>
</section>
