---
import SlideFolio from '@components/deck/SlideFolio.astro';
---

<section class="deck-slide" id="s15-result" data-slot="result">
  <SlideFolio number={15} label="The result" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">The Result · Better Investment Decisions</p>
    <p class="deck-title mt-6 reveal-item" style="--delay: 90ms">
      Investing ahead of consensus by having a <span class="gradient-text">well-sharpened theory</span> on market evolution, validated by a <span class="gradient-text">network of domain experts</span>, executed through <span class="gradient-text">codified systems</span> that scale judgement.
    </p>
    <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 200ms" />
    <p class="deck-lede mt-6 reveal-item" style="--delay: 280ms">We don't follow the market. We lead it.</p>
  </div>
</section>
