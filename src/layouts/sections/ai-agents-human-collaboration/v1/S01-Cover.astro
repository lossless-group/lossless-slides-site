---
import SlideFolio from '@components/deck/SlideFolio.astro';
---

<section class="deck-slide" id="s01-cover" data-slot="cover">
  <SlideFolio number={1} label="Cover" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">The Lossless Group · Field notes</p>
    <h1 class="deck-title-xl mt-6 max-w-[15ch] reveal-item" style="--delay: 90ms">
      Transformative Highlights from an <span class="gradient-text">AI + Agents + Human</span> Collaboration
    </h1>
    <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 180ms" />
    <p class="deck-lede mt-8 reveal-item" style="--delay: 260ms">Notes from a 2 Year Rabbit Hole</p>
    <p class="deck-label mt-4 reveal-item" style="--delay: 320ms">Michael Staton</p>
  </div>
</section>
