---
import SlideFolio from '@components/deck/SlideFolio.astro';
---

<section class="deck-slide" id="s13-close" data-slot="close">
  <SlideFolio number={13} label="Close" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">Thank you</p>
    <h2 class="deck-title-xl mt-6 max-w-[14ch] reveal-item" style="--delay: 90ms">
      Notes from a <span class="gradient-text">2 Year Rabbit Hole</span>
    </h2>
    <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 180ms" />
    <p class="deck-lede mt-8 reveal-item" style="--delay: 260ms">Michael Staton · The Lossless Group</p>
    <a
      href="https://www.lossless.group"
      class="deck-label mt-4 inline-block w-fit underline decoration-border underline-offset-4 hover:text-foreground reveal-item"
      style="--delay: 320ms"
    >lossless.group</a>
  </div>
</section>
