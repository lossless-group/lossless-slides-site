---
import SlideFolio from '@components/deck/SlideFolio.astro';

// The last word of each recommendation carries the gradient.
const recommendations = [
  { thing: 'Changelog & CI/CD', tag: 'First' },
  { thing: 'Context Vigilance', tag: 'First' },
  { thing: 'API', tag: 'First' },
  { thing: 'UI Kit', tag: 'CI/CD' },
  { thing: 'Docs', tag: 'CI/CD' },
];
---

<section class="deck-slide" id="s11-harness-recommendations" data-slot="harness-recommendations">
  <SlideFolio number={11} label="Recommendations" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">Recommendations for harness engineering</p>

    <ol class="mt-8 flex flex-col">
      {recommendations.map((rec, i) => (
        <li
          class="flex items-baseline gap-[var(--deck-gap)] border-b border-border py-3 reveal-item light:border-foreground/40"
          style={`--delay: ${90 + i * 120}ms`}
        >
          <span class="font-mono text-sm tabular-nums text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
          <span class="deck-title">
            {rec.thing} <span class="gradient-text">{rec.tag}</span>
          </span>
        </li>
      ))}
    </ol>

    <p class="deck-lede mt-10 max-w-[40rem] reveal-item" style="--delay: 760ms">
      Put those bones in, and harness engineering speeds up over time instead of stalls over time.
    </p>
  </div>
</section>
