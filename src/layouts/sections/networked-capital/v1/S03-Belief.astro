---
import SlideFolio from '@components/deck/SlideFolio.astro';

// Same number of dots on both sides: the difference is who talks to whom.
const closed = [[70, 80], [110, 60], [130, 105], [85, 125], [55, 110]];
const open = [[30, 30], [150, 25], [90, 80], [20, 130], [165, 135]];
const pairs = (points: number[][]) => points.flatMap((a, i) => points.slice(i + 1).map((b) => [a, b]));
---

<section class="deck-slide" id="s03-belief" data-slot="belief">
  <SlideFolio number={3} label="The belief" />
  <div class="deck-inner">
    <p class="deck-eyebrow reveal-item">The belief</p>
    <p class="deck-title mt-6 reveal-item" style="--delay: 90ms">
      More value is created by the <span class="gradient-text">exchange of ideas and knowledge</span> across different organizations, sectors, industries, and even countries, than by small teams of elite professionals working in relative isolation.
    </p>
    <div class="mt-10 grid max-w-[34rem] grid-cols-2 gap-[var(--deck-gap)]">
      <figure class="reveal-item" style="--delay: 260ms">
        <svg viewBox="0 0 190 160" class="h-28 w-full" role="img" aria-label="Five dots tightly clustered, connected only to each other">
          {pairs(closed).map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} stroke="var(--border)" stroke-width="1.5" />)}
          {closed.map(([x, y]) => <circle cx={x} cy={y} r="6" fill="var(--muted-foreground)" />)}
        </svg>
        <figcaption class="deck-label mt-3">Relative isolation</figcaption>
      </figure>
      <figure class="reveal-item" style="--delay: 360ms">
        <svg viewBox="0 0 190 160" class="h-28 w-full" role="img" aria-label="Five dots spread far apart, connected across the whole space">
          {pairs(open).map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} stroke="var(--primary)" stroke-opacity="0.55" stroke-width="1.5" />)}
          {open.map(([x, y]) => <circle cx={x} cy={y} r="6" fill="var(--primary)" />)}
        </svg>
        <figcaption class="deck-label mt-3">Exchange across</figcaption>
      </figure>
    </div>
  </div>
</section>
