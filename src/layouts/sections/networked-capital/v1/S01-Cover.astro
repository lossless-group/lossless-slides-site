---
import SlideFolio from '@components/deck/SlideFolio.astro';

// A loose constellation: the hub is deliberately off-center and nobody is at the top.
const nodes = [
  [60, 70], [175, 35], [300, 80], [110, 175], [235, 165], [355, 195], [45, 285], [170, 300], [305, 310],
];
const edges = [
  [0, 1], [1, 2], [0, 3], [1, 4], [2, 4], [2, 5], [3, 4], [4, 5], [3, 6], [3, 7], [4, 7], [4, 8], [5, 8], [6, 7], [7, 8],
];
---

<section class="deck-slide" id="s01-cover" data-slot="cover">
  <SlideFolio number={1} label="Cover" />
  <div class="deck-inner grid items-center gap-[var(--deck-gap)] lg:grid-cols-[1.25fr_1fr]">
    <div>
      <p class="deck-eyebrow reveal-item">The Lossless Group · A primer</p>
      <h1 class="deck-title-xl mt-6 reveal-item" style="--delay: 90ms">
        Networked <span class="gradient-text">Capital</span>
      </h1>
      <hr class="deck-rule mt-10 w-28 reveal-item" style="--delay: 180ms" />
      <p class="deck-lede mt-8 reveal-item" style="--delay: 260ms">The advantages of Open Innovation in Finance</p>
      <p class="deck-label mt-4 reveal-item" style="--delay: 320ms">Michael Staton · Made for Hypernova Capital</p>
    </div>
    <svg viewBox="0 0 400 340" class="hidden w-full lg:block reveal-item" style="--delay: 240ms" aria-hidden="true">
      {edges.map(([a, b]) => (
        <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} stroke="var(--border)" stroke-width="1.5" />
      ))}
      {nodes.map(([x, y], i) => (
        <circle cx={x} cy={y} r={i === 4 ? 11 : 7} fill={i === 4 ? 'var(--primary)' : 'var(--muted-foreground)'} />
      ))}
    </svg>
  </div>
</section>
