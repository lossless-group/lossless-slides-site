---
/**
 * DeckLayout: a full-screen document for a PageDeck. No site header or
 * footer; the deck is the page, and the player is its scroll container.
 */
import '@styles/globals.css';
import BaseHead from '@components/basics/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const SITE_MODE = import.meta.env.SITE_MODE ?? 'dark';
---
<html lang="en" data-theme={SITE_MODE}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="deck-document">
    <slot />
  </body>
</html>

<style is:global>
  /* The deck scrolls, the document does not: one scroll container, no double scrollbar. */
  body.deck-document {
    height: 100dvh;
    overflow: hidden;
  }
</style>
