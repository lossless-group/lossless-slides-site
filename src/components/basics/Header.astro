---
import brand from '@brand';
import ModeToggle from '@components/basics/ModeToggle.astro';

/**
 * Site header, adapted from mpstaton-site. One set of links, two layouts.
 *
 * At >=768px the links sit inline. Below that they collapse behind a
 * hamburger and drop down as a panel. The markup is deliberately NOT
 * duplicated per breakpoint: a second copy of the nav is a second place to
 * forget to add a link, and it puts the same href in the accessibility tree
 * twice.
 */
const links = [
  { href: '/#presentations', label: 'Presentations' },
  { href: 'https://www.lossless.group', label: 'Lossless Group' },
];
---
<header class="px-6 py-4">
  <div class="gradient-line mb-0"></div>
  <nav class="max-w-6xl mx-auto flex items-center justify-between relative" id="site-nav">
    <a href="/" class="hover:opacity-80 transition-opacity">
      <img src={brand.assets.logoDark} alt={brand.name} class="h-8 w-auto" />
    </a>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
    >
      <svg class="nav-toggle__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="nav-toggle__close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>

    <div class="nav-menu" id="nav-menu">
      {links.map((link) => (
        <a href={link.href} class="nav-link text-muted-foreground hover:text-foreground transition-colors">{link.label}</a>
      ))}
      <a href="https://github.com/lossless-group" target="_blank" rel="noopener noreferrer" class="nav-link inline-flex items-center text-muted-foreground hover:text-foreground transition-colors" aria-label="The Lossless Group on GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.930 0-1.310.465-2.380 1.235-3.220-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <ModeToggle />
    </div>
  </nav>
</header>

<style>
  /* Desktop: inline row, no toggle. */
  .nav-toggle { display: none; }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem;
      margin: -0.4rem;
      background: transparent;
      border: 0;
      color: var(--muted-foreground);
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .nav-toggle:hover { color: var(--foreground); }
    .nav-toggle__close { display: none; }
    .nav-toggle[aria-expanded='true'] .nav-toggle__open { display: none; }
    .nav-toggle[aria-expanded='true'] .nav-toggle__close { display: block; }

    /* Absolute rather than in-flow: an in-flow panel shoves the hero down the
       page as it opens, which reads as the layout breaking. */
    .nav-menu {
      position: absolute;
      top: calc(100% + 0.75rem);
      right: 0;
      left: 0;
      z-index: 50;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--background);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    }

    /* `display: none` rather than a transition: the links must leave the tab
       order when the panel is shut. */
    .nav-menu:not([data-open]) { display: none; }

    .nav-link {
      display: block;
      width: 100%;
      padding: 0.6rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.95rem;
    }
    .nav-link:hover { background: var(--muted, rgb(255 255 255 / 0.06)); }
  }
</style>

<script>
  function wireNav() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    if (!toggle || !menu || toggle.dataset.wired) return;
    toggle.dataset.wired = 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) menu.setAttribute('data-open', '');
      else menu.removeAttribute('data-open');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Collapse on choosing a destination: the panel covers the content, so
    // leaving it open hides whatever the reader just asked to see.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = e.target as HTMLElement;
      if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    // Crossing back to the desktop layout must clear the open state.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  wireNav();
  document.addEventListener('astro:page-load', wireNav);
</script>
